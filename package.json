{
  "name": "flojam",
  "description": "A real-time collaborative flowchart editor with create/join rooms, built with Next.js, React Flow and Liveblocks.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "npx liveblocks dev --persist --cmd 'next dev'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@liveblocks/client": "^3.23.0",
    "@liveblocks/node": "^3.23.0",
    "@liveblocks/react": "^3.23.0",
    "@liveblocks/react-flow": "^3.23.0",
    "@liveblocks/react-ui": "^3.23.0",
    "@xyflow/react": "^12.10.1",
    "nanoid": "^5.1.5",
    "next": "^16.2.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
