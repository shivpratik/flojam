# Secret key from https://liveblocks.io/dashboard/apikeys
# When using the local dev server (npm run dev:local), use: sk_localdev
LIVEBLOCKS_SECRET_KEY=

# Only needed for the local dev server: http://localhost:1153
NEXT_PUBLIC_LIVEBLOCKS_BASE_URL=

# Protects the daily room cleanup job. Any long random string, e.g. `openssl rand -hex 32`.
# On Vercel, Cron sends this automatically once the env var is set.
CRON_SECRET=

# Delete rooms nobody has opened in this many days (default 7).
ROOM_TTL_DAYS=
